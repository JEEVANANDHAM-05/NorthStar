# ─────────────────────────────────────────────
# NorthStar Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Admin notification recipient ─────────────
ADMIN_EMAIL=workwithnorthstar@gmail.com

# ── Primary Email Provider Selection ─────────
# Choice of first attempt: resend or sendgrid
# The system automatically switches to the backup if the limit is reached.
PRIMARY_PROVIDER=resend

# ── Resend Settings ──────────────────────────
# Sign up at: https://resend.com
RESEND_API_KEY=re_your_api_key

# ── SendGrid Settings ────────────────────────
# Sign up at: https://sendgrid.com
SENDGRID_API_KEY=sg_your_api_key

# ── Custom Verified Sender Email (Optional) ──
# If you verify your domain, specify the custom from address here
SENDER_EMAIL=contact@yourdomain.com

# ── hCaptcha (optional) ───────────────────────
# Leave blank to disable CAPTCHA verification
# Get your keys at: https://dashboard.hcaptcha.com
HCAPTCHA_SECRET=
HCAPTCHA_SITEKEY=

# ── Rate limiting ─────────────────────────────
RATE_LIMIT_MAX=5       # max submissions per IP
RATE_LIMIT_WINDOW=3600 # window in seconds (3600 = 1 hour)

# ── CORS ─────────────────────────────────────
# Comma-separated list of allowed origins
# Use * for development; restrict in production
ALLOWED_ORIGINS=*
